# Copy this file to .env and fill in your own values to enable the
# "Send Alert" email feature. Not required for the rest of the dashboard
# to work -- only /api/alerts/send needs this.

# For Gmail: enable 2-Step Verification on your Google account, then
# create an App Password at https://myaccount.google.com/apppasswords
# (use that generated password here, NOT your normal Gmail password).
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password

# Only change these if not using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional -- powers the WAQI-vs-model arbitration in /api/current (see
# app/groq_arbiter.py). If left blank, arbitration is skipped and the
# ground-station (WAQI) reading is used directly -- nothing breaks.
# Free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
